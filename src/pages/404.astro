---
// SPDX-License-Identifier: Apache-2.0
// GitHub Pages serves /404.html for any unknown path, so every link and asset here is base-absolute.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RidgeField from '../components/RidgeField.astro';
import { withBase } from '../lib/paths';
---

<Base title="Page not found · Karakoram" description="The page you were looking for does not exist on karakoram.dev." path={null}>
	<SiteHeader />
	<main id="main" class="kk-404">
		<div class="kk-container kk-404__inner">
			<p class="kk-eyebrow">404</p>
			<h1 class="kk-404__title">No route up this way.</h1>
			<p class="kk-404__lede">The page you asked for does not exist, or it moved when the documentation changed.</p>
			<div class="kk-404__cta">
				<a class="kk-btn kk-btn--primary" href={withBase('/')}>Back to the start</a>
				<a class="kk-btn kk-btn--secondary" href={withBase('/docs/')}>Browse the docs</a>
			</div>
		</div>
		<div class="kk-404__art"><RidgeField /></div>
	</main>
	<SiteFooter />
</Base>

<style>
	.kk-404 {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-block: clamp(3rem, 8vw, 7rem) clamp(12rem, 24vw, 20rem);
	}
	.kk-404__inner {
		position: relative;
		z-index: 1;
	}
	.kk-404__art {
		position: absolute;
		inset: auto 0 0 0;
		height: clamp(12rem, 28vw, 22rem);
		pointer-events: none;
	}
	.kk-404__title {
		font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
		letter-spacing: -0.03em;
		max-width: 16ch;
	}
	.kk-404__lede {
		margin-top: 1.25rem;
		max-width: 50ch;
		font-size: 1.15rem;
		color: var(--kk-muted);
	}
	.kk-404__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
