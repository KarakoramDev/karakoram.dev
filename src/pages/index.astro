---
// SPDX-License-Identifier: Apache-2.0
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RidgeField from '../components/RidgeField.astro';
import Topology from '../components/Topology.astro';
import importYaml from '../generated/import.yaml?raw';
import { withBase } from '../lib/paths';

const github = 'https://github.com/KarakoramDev/Karakoram';
const docs = (path: string) => withBase(`/docs/${path}`);

const backends = [
	{
		title: 'Zerops',
		status: 'Reference backend',
		href: docs('getting-started/quickstart/'),
		text: 'Import one YAML into an existing project. Runtimes, Local Storage volumes, HTTPS subdomains and public ports come from the Zerops REST API with a project-scoped token.',
	},
	{
		title: 'Dokploy',
		href: docs('dokploy/'),
		text: 'A Dokploy-managed Docker Swarm you operate: one application per member, node-local named volumes spread within a replica set or cluster while enough eligible nodes exist, Swarm ingress for public ports and Traefik domains for HTTPS.',
	},
	{
		title: 'Nomad',
		href: docs('nomad/'),
		text: 'A HashiCorp Nomad cluster you operate: one exec job per member on an Ubuntu rootfs, dynamic host volumes, Nomad Variables for state and your own load balancer in front.',
	},
];

const engines = [
	{
		title: 'MongoDB',
		href: docs('mongodb/'),
		text: 'Percona Server for MongoDB with Percona Backup for MongoDB: replica sets of 1, 3, 5 or 7 members, sharded clusters with config servers and mongos routers, PBM logical and physical backups, point-in-time recovery, in-place restore and clone.',
		also: { label: 'Sharded clusters', href: docs('mongodb/sharding/') },
	},
	{
		title: 'PostgreSQL',
		href: docs('postgres/'),
		text: 'Percona PostgreSQL 17 by default, with 16 and 18 majors: a single member or three- and five-member Patroni/etcd HA, a ProxySQL client service, native roles, databases and grants, pgBackRest full, differential and incremental backups with point-in-time recovery, offline restore and clone.',
		also: { label: 'Backups and PITR', href: docs('postgres/backups/') },
	},
	{
		title: 'Supabase',
		href: docs('supabase/'),
		text: 'Modular self-hosted Supabase on the PostgreSQL engine: an Envoy gateway, Auth and PostgREST by default, with Realtime, Storage, Studio, Edge Functions, Supavisor and analytics as separately sized components, versions locked to the Karakoram release.',
		also: { label: 'Components', href: docs('supabase/components/') },
	},
	{
		title: 'RabbitMQ',
		href: docs('rabbitmq/'),
		text: 'RabbitMQ 4.3 clusters of 1, 3, 5 or 7 brokers with persistent per-node storage, quorum queues by default, quorum-gated rolling changes, virtual host, user, permission and policy administration, AMQPS, optional public management UI and definitions backups (no messages or PITR).',
	},
	{
		title: 'Elasticsearch',
		href: docs('elasticsearch/'),
		text: 'Combined-node or dedicated-master clusters with optional same-version Kibana, Logstash and APM Server, native users, roles and API keys, CA-verified HTTPS, S3 snapshots with restore and clone, and shard-drain-aware scale-down.',
	},
];

const features = [
	{
		title: 'Scaling, replacement and rolling upgrades',
		href: docs('clusters/'),
		text: 'CPU and RAM bounds, persistent disk growth on Zerops, member-aware scaling and replacement, rolling upgrades and restarts that change one node at a time and wait for quorum, explicit FCV promotion for MongoDB, backup-gated major upgrades for PostgreSQL.',
	},
	{
		title: 'Backups, restore and clone',
		href: docs('backups/'),
		text: 'S3-compatible storage, UTC schedules with count retention, in-place restore and clone: PBM backups with PITR for MongoDB, pgBackRest backups with PITR for PostgreSQL and Supabase, native snapshots for Elasticsearch, definitions exports for RabbitMQ.',
	},
	{
		title: 'Suspend, resume and delete',
		href: docs('clusters/#delete-or-suspend'),
		text: 'Volumes and backups are separate assets: keep volumes to suspend a cluster and resume it later, keep backups to recover from them, or delete everything the cluster owns.',
	},
	{
		title: 'Users, TLS and access',
		href: docs('security/'),
		text: 'Engine-native accounts and roles, independently rotatable system accounts, generated or supplied TLS certificates, opt-in public TCP access with CIDR allowlists.',
	},
	{
		title: 'Monitoring, auth and RBAC',
		href: docs('monitoring/'),
		text: 'Per-member monitoring, authenticated Prometheus output, events and logs, local accounts, OIDC, RBAC and owner-scoped API tokens.',
		also: { label: 'Access control', href: docs('access-control/') },
	},
	{
		title: 'Namespaces',
		href: docs('namespaces/'),
		text: 'Operate clusters across several backend targets (Zerops projects, Dokploy environments, Nomad namespaces) from one control plane: per-namespace credentials, outbound authenticated relays and permission-gated cross-namespace restore and clone.',
	},
];

const interfaces = [
	{ label: 'REST API', href: docs('api/'), text: 'Generated, strict HTTP contract; every authenticated operation carries explicit authorization metadata.' },
	{ label: 'karactl CLI', href: docs('cli/'), text: 'Generated client for the same API, with saved connection contexts.' },
	{ label: 'Web UI', href: docs('web-ui/'), text: 'Embedded React SPA served by the control plane.' },
];
---

<Base
	title="Karakoram: self-hosted MongoDB, PostgreSQL, Supabase, RabbitMQ and Elasticsearch orchestration on your own infrastructure"
	description="Karakoram provisions and operates MongoDB (Percona Server for MongoDB with Percona Backup for MongoDB), PostgreSQL (Percona PostgreSQL, Patroni/etcd HA, pgBackRest), modular Supabase, RabbitMQ and Elasticsearch on infrastructure backends you run: Zerops, Dokploy and Nomad. Go control plane, REST API, karactl CLI and web UI. Apache-2.0, no Kubernetes, no hosted coordinator."
	path="/"
>
	<SiteHeader />

	<main id="main">
		<!-- Hero -->
		<section class="kk-hero" aria-labelledby="hero-title">
			<div class="kk-hero__art"><RidgeField /></div>
			<div class="kk-container kk-hero__inner">
				<p class="kk-eyebrow">Apache-2.0 · Self-hosted</p>
				<h1 id="hero-title" class="kk-hero__title">Self-hosted MongoDB, PostgreSQL, RabbitMQ and Elasticsearch orchestration on infrastructure you run.</h1>
				<p class="kk-hero__lede">
					Karakoram provisions and operates Percona Server for MongoDB, Percona PostgreSQL with Patroni and pgBackRest, modular Supabase,
					RabbitMQ clusters and the Elastic Stack on a backend you control: a Go control plane with a REST API, the <code>karactl</code> CLI
					and a web UI. No Kubernetes, no hosted coordinator.
				</p>
				<div class="kk-hero__cta">
					<a class="kk-btn kk-btn--primary" href={withBase('/docs/')}>Read the docs</a>
					<a class="kk-btn kk-btn--secondary" href={docs('getting-started/quickstart/')}>Install</a>
					<a class="kk-btn kk-btn--ghost" href={github} rel="noopener">View on GitHub</a>
				</div>
				<p class="kk-hero__backends">
					<span class="kk-hero__backends-label">Runs on</span>
					<a href={docs('backends/')}>Zerops</a>
					<a href={docs('dokploy/')}>Dokploy</a>
					<a href={docs('nomad/')}>Nomad</a>
					<span class="kk-hero__backends-sep" aria-hidden="true"></span>
					<a href={docs('pricing/')}>What does it cost?</a>
				</p>
			</div>
		</section>

		<!-- What it is / is not -->
		<section class="kk-section" aria-labelledby="isnot-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<h2 id="isnot-title" class="kk-section__title">What it is, and what it is not</h2>
				</div>
				<div class="kk-isnot">
					<div class="kk-isnot__col">
						<h3>Karakoram is</h3>
						<ul class="kk-list kk-list--yes">
							<li>A control plane you run on your own infrastructure backend, with your own credentials: Zerops, Dokploy or Nomad.</li>
							<li>A coordinator for five engines: Percona's PSMDB and PBM (replica sets, sharded clusters, point-in-time recovery), Percona PostgreSQL (Patroni/etcd HA, ProxySQL, pgBackRest with PITR), modular Supabase on that PostgreSQL engine, RabbitMQ clusters (quorum queues, definitions backups) and Elasticsearch with optional Kibana, Logstash and APM Server (snapshots).</li>
							<li>Yours to operate. You own the infrastructure, credentials, data and recovery procedures. The backend supplies runtimes, volumes and routing; it is not the operator of your databases and brokers.</li>
						</ul>
					</div>
					<div class="kk-isnot__col">
						<h3>Karakoram is not</h3>
						<ul class="kk-list kk-list--no">
							<li>A managed or hosted service. Nobody runs it for you.</li>
							<li>A Kubernetes operator. It talks to each backend's own API directly: the Zerops REST API, Dokploy or Nomad.</li>
							<li>A guarantee of physical-host anti-affinity or independent failure domains. Healthy voters do not prove that.</li>
							<li>Highly available itself: the control plane has one replica and each member's volume lives on a single host.</li>
						</ul>
					</div>
				</div>
				<p class="kk-isnot__more">
					<a class="kk-more" href={docs('limitations/')}>Read the limitations before production use</a>
				</p>
			</div>
		</section>

		<!-- Features -->
		<section class="kk-section" aria-labelledby="features-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<h2 id="features-title" class="kk-section__title">What it operates</h2>
					<p class="kk-section__lede">Five engines behind one control plane. Each capability links to the documentation page that describes exactly what is supported.</p>
				</div>
				<p class="kk-eyebrow kk-features__group">Engines</p>
				<ul class="kk-features">
					{engines.map((f) => (
						<li class="kk-feature">
							<h3 class="kk-feature__title"><a href={f.href}>{f.title}</a></h3>
							<p class="kk-feature__text">{f.text}</p>
							{f.also && (
								<p class="kk-feature__also">
									See also <a href={f.also.href}>{f.also.label}</a>
								</p>
							)}
						</li>
					))}
				</ul>
				<p class="kk-eyebrow kk-features__group">Across engines</p>
				<ul class="kk-features">
					{features.map((f) => (
						<li class="kk-feature">
							<h3 class="kk-feature__title"><a href={f.href}>{f.title}</a></h3>
							<p class="kk-feature__text">{f.text}</p>
							{f.also && (
								<p class="kk-feature__also">
									See also <a href={f.also.href}>{f.also.label}</a>
								</p>
							)}
						</li>
					))}
				</ul>
				<div class="kk-interfaces" aria-label="Interfaces">
					{interfaces.map((i) => (
						<a class="kk-interface" href={i.href}>
							<span class="kk-interface__label">{i.label}</span>
							<span class="kk-interface__text">{i.text}</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- Backends -->
		<section class="kk-section" aria-labelledby="backends-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<p class="kk-eyebrow">Backends</p>
					<h2 id="backends-title" class="kk-section__title">One control plane, three places to run it</h2>
					<p class="kk-section__lede">
						A backend supplies runtimes, persistent volumes and routing through its own API; Karakoram never needs Kubernetes. Zerops is the
						reference backend. See the <a href={docs('backends/')}>backend comparison</a> for status and acceptance limits.
					</p>
				</div>
				<ul class="kk-backends">
					{backends.map((b) => (
						<li class="kk-backend">
							{b.status && <p class="kk-backend__status">{b.status}</p>}
							<h3 class="kk-backend__title"><a href={b.href}>{b.title}</a></h3>
							<p class="kk-backend__text">{b.text}</p>
						</li>
					))}
				</ul>
				<p class="kk-backends__more">
					<a class="kk-more" href={docs('backends/')}>Compare the backends</a> <a class="kk-more" href={docs('pricing/')}>Pricing and cost estimates</a>
				</p>
			</div>
		</section>

		<!-- How it works -->
		<section class="kk-section" aria-labelledby="how-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<p class="kk-eyebrow">How it runs</p>
					<h2 id="how-title" class="kk-section__title">Everything lives on your own backend</h2>
					<p class="kk-section__lede">
						The figure shows a sharded MongoDB cluster. PostgreSQL members, RabbitMQ brokers and Elasticsearch nodes follow the same pattern:
						one Ubuntu 24.04 runtime and one persistent volume per node, a node agent next to the engine process, and backups written to object
						storage you register. The backend supplies the runtimes, volumes and routing; the layout is the same on Zerops, Dokploy and Nomad.
					</p>
				</div>
				<div class="kk-how">
					<div class="kk-how__diagram">
						<Topology />
					</div>
					<div class="kk-how__text">
						<dl class="kk-how__list">
							<div>
								<dt>Control plane</dt>
								<dd>
									One <code>karakoram</code> runtime with a <code>karakoramdata</code> volume for its SQLite state. Browsers and
									<code>karactl</code> reach it over HTTPS; it provisions runtimes and volumes through the backend's own API with the
									credentials you give its namespace: a project-scoped token on Zerops, an admin API key on Dokploy, an ACL token on Nomad.
								</dd>
							</div>
							<div>
								<dt>Members and nodes</dt>
								<dd>
									One Ubuntu 24.04 runtime per <code>mongod</code> (including config servers), PostgreSQL member, RabbitMQ broker or Elasticsearch
									node, each with its own persistent volume. A node agent supervises the engine process, plus the PBM agent for MongoDB and
									Patroni with etcd for PostgreSQL HA, and talks to the control plane over TLS with pinned trust roots.
								</dd>
							</div>
							<div>
								<dt>Stateless services</dt>
								<dd>
									A <code>mongos</code> router per sharded cluster, a ProxySQL client service per PostgreSQL cluster, Supabase's gateway and
									application services, and optional Kibana, Logstash and APM Server per Elasticsearch cluster, without a persistent data volume.
								</dd>
							</div>
							<div>
								<dt>Backups</dt>
								<dd>
									PBM agents write MongoDB backups and the PITR oplog, pgBackRest writes PostgreSQL base backups and WAL, Elasticsearch nodes
									write snapshots, and RabbitMQ definitions exports are uploaded to S3-compatible object storage outside the members.
								</dd>
							</div>
						</dl>
						<p><a class="kk-more" href={docs('architecture/')}>Architecture and trust boundaries</a></p>
					</div>
				</div>
			</div>
		</section>

		<!-- Install -->
		<section class="kk-section" aria-labelledby="quickstart-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<p class="kk-eyebrow">Install</p>
					<h2 id="quickstart-title" class="kk-section__title">Deploy on Zerops with one import, or bring your own Dokploy or Nomad</h2>
					<p class="kk-section__lede">
						On Zerops, the reference backend, the import below creates the control plane service and its volume in an existing project; you need a
						project-scoped Full access integration token. Dokploy and Nomad have their own guides.
					</p>
				</div>
				<div class="kk-quick">
					<div class="kk-quick__code">
						<div class="kk-code">
							<div class="kk-code__bar">
								<span>deploy/zerops/import.yaml</span>
								<button class="kk-copy" type="button" data-copy aria-label="Copy import YAML to clipboard">Copy</button>
							</div>
							<Code code={importYaml} lang="yaml" themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} />
						</div>
					</div>
					<ol class="kk-steps">
						<li>
							<strong>Import the services.</strong> In your project's dashboard choose <em>Import services</em> and paste the YAML, or
							run <code>zcli project service-import import.yaml -P "$PROJECT_ID"</code>.
						</li>
						<li>
							<strong>Set the token.</strong> On the <code>karakoram</code> service, set the secret <code>KARAKORAM_ZEROPS_TOKEN</code> to your
							project-scoped Full access integration token. Never commit it. Keep the generated <code>KARAKORAM_MASTER_KEY</code> and
							<code>KARAKORAM_ADMIN_PASSWORD</code>.
						</li>
						<li>
							<strong>Wait for build and deploy.</strong> The Git build and deploy processes must finish; the import response alone is not enough.
							If the token was empty at import, set it and restart or redeploy.
						</li>
						<li>
							<strong>Sign in.</strong> Open the service's HTTPS subdomain, sign in as <code>admin</code> with the
							generated <code>KARAKORAM_ADMIN_PASSWORD</code>, change the password, then sign in again.
						</li>
					</ol>
				</div>
				<p class="kk-quick__more">
					<a class="kk-more" href={docs('getting-started/quickstart/')}>Zerops quick start</a> <a class="kk-more" href={docs('getting-started/install/')}>Full installation guide</a>
					<span class="kk-quick__note">
						Covers prerequisites, secret handling, installing from a local checkout with <code>zcli</code>, custom domains and CLI login.
					</span>
				</p>
				<div class="kk-paths" aria-label="Other install paths">
					<a class="kk-path" href={docs('dokploy/')}>
						<span class="kk-path__label">Dokploy</span>
						<span class="kk-path__text">Build the control plane image from <code>deploy/dokploy/Dockerfile</code> on your Swarm; members become Dokploy applications.</span>
					</a>
					<a class="kk-path" href={docs('nomad/')}>
						<span class="kk-path__label">Nomad</span>
						<span class="kk-path__text">Register the supplied job, volume and ACL policy from <code>deploy/nomad/</code>; members become exec jobs on your clients.</span>
					</a>
					<a class="kk-path" href={docs('pricing/')}>
						<span class="kk-path__label">What does it cost?</span>
						<span class="kk-path__text">Karakoram is free software. You pay for the infrastructure you use: runtimes or hosts, persistent storage and separately provisioned S3-compatible object storage. The pricing page walks through estimates.</span>
					</a>
				</div>
			</div>
		</section>

		<!-- Acknowledgements and the name -->
		<section class="kk-section kk-ack" aria-labelledby="ack-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<h2 id="ack-title" class="kk-section__title">Built on Percona, RabbitMQ, Elastic and Supabase, inspired by OpenEverest</h2>
				</div>
				<div class="kk-ack__grid">
					<article class="kk-ack__item">
						<h3>Percona</h3>
						<p>
							Thank you to Percona for <a href="https://www.percona.com/mongodb/software/percona-server-for-mongodb" rel="noopener">Percona Server for MongoDB</a>, <a
								href="https://docs.percona.com/percona-backup-mongodb/latest/"
								rel="noopener">Percona Backup for MongoDB</a> and <a href="https://www.percona.com/postgresql/software" rel="noopener">Percona Distribution for PostgreSQL</a>.
							Karakoram installs them from Percona's official package repositories at <a href="https://repo.percona.com/" rel="noopener">repo.percona.com</a>.
							The engines, replication, backups and point-in-time recovery come from their open-source work, together with <a
								href="https://patroni.readthedocs.io"
								rel="noopener">Patroni</a>, <a href="https://etcd.io" rel="noopener">etcd</a>, <a href="https://pgbackrest.org" rel="noopener">pgBackRest</a> and <a
								href="https://proxysql.com"
								rel="noopener">ProxySQL</a>; Karakoram coordinates those capabilities rather than reinventing them.
						</p>
					</article>
					<article class="kk-ack__item">
						<h3>RabbitMQ and Elastic</h3>
						<p>
							Thank you to the <a href="https://www.rabbitmq.com" rel="noopener">RabbitMQ</a> team for the broker, quorum queues and the
							Management API, and to <a href="https://www.elastic.co" rel="noopener">Elastic</a> for Elasticsearch, Kibana, Logstash and APM Server.
							Karakoram installs both on your own runtimes at deploy time, from RabbitMQ's package repositories and Elastic's official
							distributions, and redistributes no binaries. Elastic's default distributions carry their own license terms, described in
							the <a href={docs('elasticsearch/#licensing')}>Elasticsearch guide</a>.
						</p>
					</article>
					<article class="kk-ack__item">
						<h3>Supabase</h3>
						<p>
							Thank you to <a href="https://supabase.com" rel="noopener">Supabase</a> for Auth, PostgREST, Realtime, Storage, Studio, Edge Runtime,
							Supavisor and the rest of the open-source stack that the Supabase engine assembles on top of the PostgreSQL engine, and to <a
								href="https://www.envoyproxy.io"
								rel="noopener">Envoy</a> for the gateway. Component versions are locked to each Karakoram release and installed on your own
							runtimes from checksum-pinned artifacts; see <a href={docs('supabase/components/')}>components and availability</a>.
						</p>
					</article>
					<article class="kk-ack__item">
						<h3>OpenEverest</h3>
						<p>
							<a href="https://openeverest.io" rel="noopener">OpenEverest</a> is the inspiration for this project. Originally Percona Everest,
							it is an Apache-2.0 CNCF Sandbox project whose model of self-hosted, provider-based database orchestration shaped Karakoram:
							Provider and Instance concepts, version bundles, topology schemas, backup storages, PITR and restore flows, and RBAC.
							Karakoram brings that idea to platforms such as Zerops, Dokploy and Nomad rather than Kubernetes. It is an independent implementation;
							no OpenEverest code or UI is copied.
						</p>
					</article>
					<article class="kk-ack__item kk-ack__item--name">
						<h3>The name</h3>
						<p class="kk-ack__quote">
							Everest is the highest peak. Karakoram is the range that holds K2 and other giants.
						</p>
						<p>
							The name is a nod to OpenEverest and to growing beyond a single peak. Five engines run on three backends today: MongoDB, PostgreSQL,
							Supabase, RabbitMQ and Elasticsearch on Zerops, Dokploy and Nomad. More engines and backends are a direction,
							not a claim that they exist.
						</p>
					</article>
				</div>
			</div>
		</section>

		<!-- Community -->
		<section class="kk-section" aria-labelledby="community-title">
			<div class="kk-container">
				<div class="kk-community">
					<div class="kk-community__text">
						<h2 id="community-title" class="kk-section__title">Contributions are welcome</h2>
						<p class="kk-section__lede">
							Open an issue first for anything beyond a small fix, keep each pull request to one logical change, and sign off every commit
							under the Developer Certificate of Origin (<code>git commit -s</code>). A human submits every contribution.
						</p>
					</div>
					<ul class="kk-community__links">
						<li><a class="kk-more" href={docs('contributing/')}>Contributing guide</a></li>
						<li><a class="kk-more" href={docs('code-of-conduct/')}>Code of conduct</a></li>
						<li><a class="kk-more" href={`${github}/issues`} rel="noopener">GitHub issues</a></li>
						<li><a class="kk-more" href={docs('security/#reporting-vulnerabilities')}>Report a vulnerability</a></li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Supported by -->
		<section class="kk-section kk-support" aria-labelledby="support-title">
			<div class="kk-container kk-support__inner">
				<p id="support-title" class="kk-eyebrow">Supported by</p>
				<p class="kk-support__text">
					Thank you to <a href="https://zerops.io" rel="noopener">Zerops</a> for providing free-of-charge infrastructure for developing and testing Karakoram.
				</p>
			</div>
		</section>
	</main>

	<SiteFooter />

	<script is:inline>
		for (const b of document.querySelectorAll('[data-copy]')) {
			b.addEventListener('click', async () => {
				const pre = b.closest('.kk-code').querySelector('pre');
				try {
					await navigator.clipboard.writeText(pre.textContent);
					b.dataset.copied = '';
					b.textContent = 'Copied';
					setTimeout(() => {
						delete b.dataset.copied;
						b.textContent = 'Copy';
					}, 1800);
				} catch {
					b.textContent = 'Select and copy';
				}
			});
		}
	</script>
