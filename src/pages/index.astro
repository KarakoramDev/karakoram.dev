---
// SPDX-License-Identifier: Apache-2.0
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RidgeField from '../components/RidgeField.astro';
import Topology from '../components/Topology.astro';
import BrandIcon from '../components/BrandIcon.astro';
import importYaml from '../generated/import.yaml?raw';
import { withBase } from '../lib/paths';

const github = 'https://github.com/KarakoramDev/Karakoram';
const docs = (path: string) => withBase(`/docs/${path}`);

const backends = [
	{
		title: 'Zerops',
		brand: 'zerops',
		status: 'Reference backend',
		href: docs('zerops/'),
		text: 'Import one YAML into an existing project. Runtimes, Local Storage volumes, HTTPS subdomains and public ports come from the <a href="https://zerops.io">Zerops</a> REST API with a project-scoped token.',
	},
	{
		title: 'Dokploy',
		brand: 'dokploy',
		href: docs('dokploy/'),
		text: 'A <a href="https://dokploy.com">Dokploy</a>-managed <a href="https://docs.docker.com/engine/swarm/">Docker Swarm</a> you operate: one application per member, node-local named volumes spread within a replica set or cluster while enough eligible nodes exist, Swarm ingress for public ports and <a href="https://traefik.io/traefik/">Traefik</a> domains for HTTPS.',
	},
	{
		title: 'Nomad',
		brand: 'nomad',
		href: docs('nomad/'),
		text: 'A <a href="https://developer.hashicorp.com/nomad">HashiCorp Nomad</a> cluster you operate: one exec job per member on an <a href="https://ubuntu.com">Ubuntu</a> rootfs, dynamic host volumes, Nomad Variables for state and your own load balancer in front.',
	},
];

// Status is shown once per card: engines added in v0.4.0 are experimental until exercised against live backends;
// fleet operations are verified offline (tests without a live backend).
const engines = [
	{
		title: 'MongoDB',
		brand: 'mongodb',
		href: docs('mongodb/'),
		text: '<a href="https://www.percona.com/mongodb/software/percona-server-for-mongodb">Percona Server for MongoDB</a> with <a href="https://docs.percona.com/percona-backup-mongodb/latest/">Percona Backup for MongoDB</a>: replica sets of 1, 3, 5 or 7 members, sharded clusters with config servers and mongos routers, PBM logical and physical backups, point-in-time recovery, in-place restore and clone.',
		also: [{ label: 'Sharded clusters', href: docs('mongodb/sharding/') }],
	},
	{
		title: 'PostgreSQL',
		brand: 'postgresql',
		href: docs('postgres/'),
		text: '<a href="https://www.percona.com/postgresql/software">Percona PostgreSQL</a> 17 by default, with 16 and 18 majors: a single member or three- and five-member <a href="https://patroni.readthedocs.io">Patroni</a>/<a href="https://etcd.io">etcd</a> HA with a <a href="https://proxysql.com">ProxySQL</a> client service, <a href="https://postgis.net">PostGIS</a>, <a href="https://github.com/pgvector/pgvector">pgvector</a> and <a href="https://www.timescale.com">TimescaleDB</a> extension profiles, native roles, databases and grants, bindings that give a consumer its own role and databases, <a href="https://pgbackrest.org">pgBackRest</a> full, differential and incremental backups with point-in-time recovery, offline restore and clone, and an experimental <a href="https://www.citusdata.com">Citus</a> distributed topology of one coordinator plus up to eight worker groups.',
		also: [
			{ label: 'Extension profiles', href: docs('postgres/profiles/') },
			{ label: 'Consumer bindings', href: docs('postgres/bindings/') },
			{ label: 'Distributed (Citus)', href: docs('postgres/distributed/') },
		],
	},
	{
		title: 'Supabase',
		brand: 'supabase',
		href: docs('supabase/'),
		text: 'Modular self-hosted <a href="https://supabase.com">Supabase</a> on the <a href="https://www.postgresql.org">PostgreSQL</a> engine: an <a href="https://www.envoyproxy.io">Envoy</a> gateway, Auth and <a href="https://postgrest.org">PostgREST</a> by default, with Realtime, Storage, Studio, Edge Functions, Supavisor and analytics as separately sized components, versions locked to the Karakoram release.',
		also: [{ label: 'Components', href: docs('supabase/components/') }],
	},
	{
		title: 'RabbitMQ',
		brand: 'rabbitmq',
		href: docs('rabbitmq/'),
		text: '<a href="https://www.rabbitmq.com">RabbitMQ</a> 4.3 clusters of 1, 3, 5 or 7 brokers with persistent per-node storage, quorum queues by default, quorum-gated rolling changes, virtual host, user, permission and policy administration, AMQPS, optional public management UI and definitions backups (no messages or PITR).',
	},
	{
		title: 'Elasticsearch',
		brand: 'elasticsearch',
		href: docs('elasticsearch/'),
		text: 'Combined-node or dedicated-master <a href="https://www.elastic.co/elasticsearch">Elasticsearch</a> clusters with optional same-version <a href="https://www.elastic.co/kibana">Kibana</a>, <a href="https://www.elastic.co/logstash">Logstash</a> and <a href="https://www.elastic.co/observability/application-performance-monitoring">APM Server</a>, native users, roles and API keys, CA-verified HTTPS, S3 snapshots with restore and clone, and shard-drain-aware scale-down.',
	},
	{
		title: 'MySQL',
		brand: 'mysql',
		status: 'Experimental',
		href: docs('mysql/'),
		text: '<a href="https://www.percona.com/mysql/software/percona-server-for-mysql">Percona Server for MySQL</a> 8.4 by default, with 8.0: a single member or three- and five-member single-primary Group Replication behind ProxySQL, native users, databases and grants, <a href="https://www.percona.com/mysql/software/percona-xtrabackup">XtraBackup</a> full and incremental backups with GTID-based point-in-time recovery.',
		also: [{ label: 'Backups and PITR', href: docs('mysql/backups/') }],
	},
	{
		title: 'Percona XtraDB Cluster',
		brand: 'percona',
		status: 'Experimental',
		href: docs('mysql/'),
		text: 'A separate provider for <a href="https://galeracluster.com">Galera</a> clusters of three or five <a href="https://www.percona.com/mysql/software/percona-xtradb-cluster">Percona XtraDB Cluster</a> 8.4 or 8.0 members with encrypted IST and SST, one ProxySQL-routed writer despite Galera\u2019s multi-writer capability, the same <a href="https://www.mysql.com">MySQL</a> access interface, and XtraBackup backups with PITR kept under their own provenance.',
		also: [{ label: 'Configuration and topology', href: docs('mysql/configuration/') }],
	},
	{
		title: 'Neo4j Community',
		brand: 'neo4j',
		status: 'Experimental',
		href: docs('neo4j/'),
		text: '<a href="https://neo4j.com">Neo4j Community</a> 2026.10 on a <a href="https://adoptium.net">Temurin</a> 21 JRE: exactly one member with a persistent volume, required TLS, allowlisted settings with heap and page-cache overrides, and offline dumps of the system and graph databases as backups. Every backup is an outage, so schedules need explicit consent; there is no PITR.',
		also: [{ label: 'Offline backups', href: docs('neo4j/backups/') }],
	},
	{
		title: 'Weaviate',
		brand: 'weaviate',
		status: 'Experimental',
		href: docs('weaviate/'),
		text: 'Official <a href="https://weaviate.io">Weaviate</a> 1.40 binaries with community features only: a single member or clusters of 3 to 9 data members with three fixed Raft voters, API keys, RBAC and dynamic database users, client TLS by default, native S3 full backups (no incremental or PITR) and scale-down that drains replicas before removing non-voters.',
		also: [{ label: 'Access and TLS', href: docs('weaviate/access-and-tls/') }],
	},
	{
		title: 'Keycloak',
		brand: 'keycloak',
		status: 'Experimental',
		href: docs('keycloak/'),
		text: 'Official <a href="https://www.keycloak.org">Keycloak</a> 26.8 on <a href="https://openjdk.org">OpenJDK</a> 21: one native runtime whose realms, identities and sessions live in a bound PostgreSQL database with a dedicated non-superuser role, JDBC over verify-full TLS, sealed bootstrap credentials and a private HTTP port for your TLS-terminating ingress.',
		also: [{ label: 'PostgreSQL bindings', href: docs('postgres/bindings/') }],
	},
	{
		title: 'OpenBao',
		brand: 'openbao',
		status: 'Experimental',
		href: docs('openbao/'),
		text: '<a href="https://openbao.org">OpenBao</a> 2.7 with integrated Raft: 1, 3 or 5 members, mandatory TLS with a cluster CA, a Shamir seal by default or transit and <a href="https://aws.amazon.com/kms/">AWS KMS</a> auto-unseal, S3 Raft-snapshot backups (no PITR), and native tokens and policies for application access.',
		also: [{ label: 'Operations and unseal', href: docs('openbao/operations/') }],
	},
	{
		title: 'Temporal',
		brand: 'temporal',
		status: 'Experimental',
		href: docs('temporal/'),
		text: '<a href="https://temporal.io">Temporal</a> 1.32 or 1.31 with the release-locked web UI, persisted in a bound PostgreSQL cluster: a combined server or split stateless roles with independent replicas, a private TLS gRPC frontend with client certificates, and recovery from the source PostgreSQL backup plus a cluster-state manifest. Runs on Dokploy and Nomad; not yet on Zerops, which lacks the private IPv4 route it needs.',
		also: [{ label: 'Operations and recovery', href: docs('temporal/operations/') }],
	},
];

const features = [
	{
		title: 'Scaling, replacement and rolling upgrades',
		href: docs('clusters/'),
		text: 'CPU and RAM bounds, persistent disk growth on Zerops, member-aware scaling and replacement, rolling upgrades and restarts that change one node at a time and wait for quorum, explicit FCV promotion for MongoDB, backup-gated major upgrades for PostgreSQL.',
	},
	{
		title: 'Backups, restore and clone',
		href: docs('backups/'),
		text: 'S3-compatible storage, UTC schedules with count retention, in-place restore and clone: PBM backups with PITR for MongoDB, pgBackRest backups with PITR for PostgreSQL and Supabase, XtraBackup with PITR for MySQL and PXC, native snapshots for Elasticsearch and Weaviate, Raft snapshots for OpenBao, offline dumps for Neo4j, definitions exports for RabbitMQ.',
	},
	{
		title: 'Fleet operations and recovery',
		status: 'Verified offline',
		href: docs('control-plane-backup/'),
		text: 'Rolling agent upgrades kept separate from database upgrades, maintenance windows that defer disruptive work, member relocation through native replacement, S3 snapshots of the control plane\u2019s own state with rebuild runbooks, webhook, <a href="https://slack.com">Slack</a> and email notification channels, and backup drills that restore a backup into a scratch cluster and record what was checked.',
		also: [
			{ label: 'Backup drills', href: docs('backup-drills/') },
			{ label: 'Notifications', href: docs('notifications/') },
			{ label: 'Maintenance windows', href: docs('operations/#maintenance-windows') },
		],
	},
	{
		title: 'Suspend, resume and delete',
		href: docs('clusters/#delete-or-suspend'),
		text: 'Volumes and backups are separate assets: keep volumes to suspend a cluster and resume it later, keep backups to recover from them, or delete everything the cluster owns.',
	},
	{
		title: 'Users, TLS and access',
		href: docs('security/'),
		text: 'Engine-native accounts and roles, independently rotatable system accounts, generated or supplied TLS certificates, opt-in public TCP access with CIDR allowlists.',
	},
	{
		title: 'Monitoring, auth and RBAC',
		href: docs('monitoring/'),
		text: 'Per-member monitoring, authenticated <a href="https://prometheus.io">Prometheus</a> output, events and logs, local accounts, OIDC, RBAC and owner-scoped API tokens.',
		also: [{ label: 'Access control', href: docs('access-control/') }],
	},
	{
		title: 'Namespaces',
		href: docs('namespaces/'),
		text: 'Operate clusters across several backend targets (Zerops projects, Dokploy environments, Nomad namespaces) from one control plane: per-namespace credentials, outbound authenticated relays and permission-gated cross-namespace restore and clone.',
	},
];

const interfaces = [
	{ label: 'REST API', href: docs('api/'), text: 'Generated, strict HTTP contract; every authenticated operation carries explicit authorization metadata.' },
	{ label: 'karactl CLI', href: docs('cli/'), text: 'Generated client for the same API, with saved connection contexts.' },
	{ label: 'Web UI', href: docs('web-ui/'), text: 'Embedded React SPA served by the control plane.' },
	{ label: 'MCP server', href: docs('mcp-quickstart/'), text: 'The same API as tools for AI agents, read-only by default, over Streamable HTTP or a stdio bridge.' },
];

const mcpConfig = `# Management MCP: a read-only token for one namespace, printed as a
# \`claude mcp add\` command (or --client cursor, vscode, codex, json)
karactl mcp config --client claude-code -n production

# Cluster data MCP: a token for the data inside one cluster
karactl mcp config --cluster production/appdb --client cursor`;
---

<Base
	title="Karakoram: self-hosted database and stateful-service orchestration"
	description="Self-hosted database and stateful-service orchestration on infrastructure you run: Zerops, Dokploy or Nomad. One control plane with a REST API, karactl CLI, web UI and MCP server for AI agents. Apache-2.0, no Kubernetes, no hosted coordinator."
	path="/"
>
	<SiteHeader />

	<main id="main">
		<!-- Hero -->
		<section class="kk-hero" aria-labelledby="hero-title">
			<div class="kk-hero__art"><RidgeField /></div>
			<div class="kk-container kk-hero__inner">
				<p class="kk-eyebrow">Apache-2.0 · Self-hosted</p>
				<h1 id="hero-title" class="kk-hero__title">Self-hosted database and stateful-service orchestration on infrastructure you run.</h1>
				<p class="kk-hero__lede">
					Karakoram provisions and operates databases, message brokers, search, identity, secrets and workflow engines on a backend you control:
					a <a href="https://go.dev">Go</a> control plane with a REST API, the <code>karactl</code> CLI, a web UI and an <a href="https://modelcontextprotocol.io">MCP</a> server for AI agents.
					No <a href="https://kubernetes.io">Kubernetes</a>, no hosted coordinator.
				</p>
				<div class="kk-hero__cta">
					<a class="kk-btn kk-btn--primary" href={withBase('/docs/')}>Read the docs</a>
					<a class="kk-btn kk-btn--secondary" href={docs('getting-started/quickstart/')}>Install</a>
					<a class="kk-btn kk-btn--ghost" href={github} rel="noopener">View on GitHub</a>
				</div>
				<p class="kk-hero__backends">
					<span class="kk-hero__backends-label">Runs on</span>
					{backends.map((b) => (
						<a href={b.href}><BrandIcon brand={b.brand} /> {b.title}</a>
					))}
					<span class="kk-hero__backends-sep" aria-hidden="true"></span>
					<a href={docs('operating-costs/')}>What does it cost?</a>
				</p>
			</div>
		</section>

		<!-- What it is / is not -->
		<section class="kk-section" aria-labelledby="isnot-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<h2 id="isnot-title" class="kk-section__title">What it is, and what it is not</h2>
				</div>
				<div class="kk-isnot">
					<div class="kk-isnot__col">
						<h3>Karakoram is</h3>
						<ul class="kk-list kk-list--yes">
							<li>A control plane you run on your own infrastructure backend, with your own credentials: Zerops, Dokploy or Nomad.</li>
							<li>A coordinator for databases, message brokers, search, identity, secrets and workflow engines, with engine-specific topologies, access controls and recovery procedures.</li>
							<li>Yours to operate. You own the infrastructure, credentials, data and recovery procedures. The backend supplies runtimes, volumes and routing; it is not the operator of your databases and services.</li>
						</ul>
					</div>
					<div class="kk-isnot__col">
						<h3>Karakoram is not</h3>
						<ul class="kk-list kk-list--no">
							<li>A managed or hosted service. Nobody runs it for you.</li>
							<li>A Kubernetes operator. It talks to each backend's own API directly: the Zerops REST API, Dokploy or Nomad.</li>
							<li>A guarantee of physical-host anti-affinity or independent failure domains. Healthy voters do not prove that.</li>
							<li>Highly available itself: the control plane has one replica and each member's volume lives on a single host.</li>
						</ul>
					</div>
				</div>
				<p class="kk-isnot__more">
					<a class="kk-more" href={docs('limitations/')}>Read the limitations before production use</a>
				</p>
			</div>
		</section>

		<!-- Features -->
		<section class="kk-section" aria-labelledby="features-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<h2 id="features-title" class="kk-section__title">What it operates</h2>
					<p class="kk-section__lede">
						Twelve engines behind one control plane. Each card shows its release status and links to the documentation
						that describes supported capabilities and backend availability.
					</p>
				</div>
				{[['Engines', engines], ['Across engines', features]].map(([group, items]) => (
					<>
						<p class="kk-eyebrow kk-features__group">{group}</p>
						<ul class="kk-features">
							{items.map((f) => (
								<li class="kk-feature">
									<h3 class:list={['kk-feature__title', { 'kk-feature__title--brand': f.brand }]}>
										{f.brand && <BrandIcon brand={f.brand} tile />}
										<a href={f.href}>{f.title}{f.status && <small>{f.status}</small>}</a>
									</h3>
									<p class="kk-feature__text" set:html={f.text} />
									{f.also && (
										<p class="kk-feature__also">
											See also {f.also.map((link, index) => (
												<>
													{index > 0 && ' · '}
													<a href={link.href}>{link.label}</a>
												</>
											))}
										</p>
									)}
								</li>
							))}
						</ul>
					</>
				))}
				<div class="kk-interfaces" aria-label="Interfaces">
					{interfaces.map((i) => (
						<a class="kk-interface" href={i.href}>
							<span class="kk-interface__label">{i.label}</span>
							<span class="kk-interface__text">{i.text}</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- Backends -->
		<section class="kk-section" aria-labelledby="backends-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<p class="kk-eyebrow">Backends</p>
					<h2 id="backends-title" class="kk-section__title">One control plane, three places to run it</h2>
					<p class="kk-section__lede">
						A backend supplies runtimes, persistent volumes and routing through its own API; Karakoram never needs Kubernetes. <a href="https://zerops.io">Zerops</a> is the
						reference backend. See the <a href={docs('backends/')}>backend comparison</a> for status and acceptance limits.
					</p>
				</div>
				<ul class="kk-backends">
					{backends.map((b) => (
						<li class="kk-backend">
							{b.status && <p class="kk-backend__status">{b.status}</p>}
							<h3 class="kk-backend__title"><BrandIcon brand={b.brand} tile /><a href={b.href}>{b.title}</a></h3>
							<p class="kk-backend__text" set:html={b.text} />
						</li>
					))}
				</ul>
				<p class="kk-backends__more">
					<a class="kk-more" href={docs('backends/')}>Compare the backends</a> <a class="kk-more" href={docs('operating-costs/')}>Operating costs</a>
				</p>
			</div>
		</section>

		<!-- How it works -->
		<section class="kk-section" aria-labelledby="how-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<p class="kk-eyebrow">How it runs</p>
					<h2 id="how-title" class="kk-section__title">Everything lives on your own backend</h2>
					<p class="kk-section__lede">
						The figure shows a sharded <a href="https://www.mongodb.com">MongoDB</a> cluster. PostgreSQL and MySQL members, RabbitMQ brokers, Elasticsearch, Weaviate and OpenBao nodes
						follow the same pattern: one Ubuntu 24.04 runtime and one persistent volume per node, a node agent next to the engine process, and
						backups written to object storage you register. The backend supplies the runtimes, volumes and routing; the layout is the same on
						Zerops, Dokploy and Nomad.
					</p>
				</div>
				<div class="kk-how">
					<div class="kk-how__diagram">
						<Topology />
					</div>
					<div class="kk-how__text">
						<dl class="kk-how__list">
							<div>
								<dt>Control plane</dt>
								<dd>
									One <code>karakoram</code> runtime with a <code>karakoramdata</code> volume for its SQLite state. Browsers and
									<code>karactl</code> reach it over HTTPS; it provisions runtimes and volumes through the backend's own API with the
									credentials you give its namespace: a project-scoped token on Zerops, an admin API key on Dokploy, an ACL token on Nomad.
								</dd>
							</div>
							<div>
								<dt>Members and nodes</dt>
								<dd>
									One Ubuntu 24.04 runtime per <code>mongod</code> (including config servers), PostgreSQL or MySQL member, RabbitMQ broker,
									Elasticsearch, Weaviate or OpenBao node and Neo4j server, each with its own persistent volume. A node agent supervises the
									engine process, plus the PBM agent for MongoDB and Patroni with etcd for PostgreSQL HA, and talks to the control plane over
									TLS with pinned trust roots.
								</dd>
							</div>
							<div>
								<dt>Stateless services</dt>
								<dd>
									A <code>mongos</code> router per sharded cluster, a ProxySQL client service per PostgreSQL or MySQL cluster, Supabase's gateway
									and application services, optional Kibana, Logstash and APM Server per Elasticsearch cluster, and Keycloak and Temporal roles
									that keep their state in a bound PostgreSQL cluster, without a persistent data volume.
								</dd>
							</div>
							<div>
								<dt>Backups</dt>
								<dd>
									PBM agents write MongoDB backups and the PITR oplog, pgBackRest writes PostgreSQL base backups and WAL, XtraBackup writes MySQL
									and PXC backups and binary logs, Elasticsearch and Weaviate nodes write snapshots, OpenBao writes Raft snapshots, and RabbitMQ
									definitions exports and Neo4j dumps are uploaded to S3-compatible object storage outside the members.
								</dd>
							</div>
						</dl>
						<p><a class="kk-more" href={docs('architecture/')}>Architecture and trust boundaries</a></p>
					</div>
				</div>
			</div>
		</section>

		<!-- AI agents -->
		<section class="kk-section" aria-labelledby="agents-title">
			<div class="kk-container">
				<div class="kk-section__head">
					<p class="kk-eyebrow">AI agents</p>
					<h2 id="agents-title" class="kk-section__title">Let an agent operate it. Read-only until you say otherwise.</h2>
					<p class="kk-section__lede">
						The control plane embeds an MCP server at <code>/mcp</code>: every REST operation is a tool, executed through the same
						authentication, RBAC and audit path as <code>karactl</code>. <a href="https://code.claude.com">Claude Code</a>, <a href="https://claude.com/download">Claude Desktop</a>, <a href="https://cursor.com">Cursor</a>, <a href="https://code.visualstudio.com">VS Code</a>, <a href="https://developers.openai.com/codex/">Codex</a> or any
						other spec-compliant client connects with a restricted token or OAuth.
					</p>
				</div>
				<div class="kk-agents">
					<div class="kk-agents__code">
						<div class="kk-code">
							<div class="kk-code__bar">
								<span>karactl mcp config</span>
								<button class="kk-copy" type="button" data-copy aria-label="Copy karactl mcp config commands to clipboard">Copy</button>
							</div>
							<Code code={mcpConfig} lang="sh" themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} />
						</div>
						<p class="kk-agents__note">
							Each command creates a dedicated API token, read-only unless you pass <code>--write</code>, and prints the client
							configuration once. The secret never exceeds its owner's permissions and expires after 90 days by default.
						</p>
					</div>
					<dl class="kk-agents__list">
						<div>
							<dt>Read-only by default</dt>
							<dd>
								<code>KARAKORAM_MCP=readonly</code> is the installation default. <code>readwrite</code> is an explicit operator opt-in
								in the service environment; <code>off</code> removes the endpoint.
							</dd>
						</div>
						<div>
							<dt>Restricted tokens</dt>
							<dd>
								Tokens limited to read actions, namespaces or one cluster, intersected with the owner's RBAC on every call. Opt-in
								OAuth 2.1 with PKCE for connectors such as Claude Desktop, audience-bound to <code>/mcp</code>.
							</dd>
						</div>
						<div>
							<dt>Confirmation for destructive actions</dt>
							<dd>
								The server writes the summary, binds the approval to the exact arguments for five minutes and audits the answer.
								There is no model-settable confirm flag; a client without elicitation gets an error, not a deletion.
							</dd>
						</div>
						<div>
							<dt>Per-cluster data MCP <small>experimental</small></dt>
							<dd>
								One endpoint per cluster for the data inside it: MongoDB and PostgreSQL/Supabase through reviewed upstream servers,
								Elasticsearch and RabbitMQ natively, with rotated read/write database identities and four independent write switches.
							</dd>
						</div>
						<div>
							<dt><code>llms.txt</code></dt>
							<dd>
								This site publishes <a href={withBase('/llms.txt')}>/llms.txt</a>, <a href={withBase('/llms-full.txt')}>/llms-full.txt</a> and a
								Markdown twin of every documentation page, so agents can read the manual as easily as the API.
							</dd>
						</div>
					</dl>
				</div>
				<p class="kk-agents__more">
