---
// SPDX-License-Identifier: Apache-2.0
// Starlight `PageTitle` override (0.42.6): the page title, preceded by the brand mark of the
// engine or provider the page documents (`brand` frontmatter, written by scripts/ingest-docs.mjs).
import BrandIcon from './BrandIcon.astro';

const { title, brand } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top" class:list={{ 'kk-title--brand': brand }}>
	{brand && <BrandIcon brand={brand} tile />}
	<span>{title}</span>
</h1>

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
	.kk-title--brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.kk-title--brand > :global(.kk-brand-tile) {
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.55rem;
		border-radius: 10px;
	}
	@media (max-width: 50rem) {
		.kk-title--brand > :global(.kk-brand-tile) {
			width: 2.25rem;
			height: 2.25rem;
			font-size: 1.25rem;
			border-radius: 8px;
		}
	}
</style>
