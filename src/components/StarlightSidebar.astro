---
// SPDX-License-Identifier: Apache-2.0
// Starlight `Sidebar` override (0.42.6): identical to Starlight's, except the list is rendered by
// StarlightSidebarList, which adds brand marks to engine groups and backend pages.
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import StarlightSidebarList from './StarlightSidebarList.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<SidebarPersister>
	<StarlightSidebarList sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
